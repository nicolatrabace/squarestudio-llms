NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=CHANGE_ME

NEXT_PUBLIC_WEBAPP_URL=https://sign.squarestudio.design
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000
